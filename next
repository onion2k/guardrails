#!/bin/sh
# next: one screen for a project, saying where each open plan stands and
# what its git and its remote hold that the tidy skill would find. Without
# it the work in a project is known only by someone counting boxes and
# listing branches by hand, and a plan whose branch has merged or gone is
# reported as still being built.
#
#   sh guardrails/next            the project the shell is in
#   sh guardrails/next <folder>   that project
#   sh next                       in the kit itself
#
# It writes nothing: no fetch, no merge-tree, no file, and nothing under
# .git. The changes in a tree are read with `git status --porcelain`, which
# compares contents, so that a file touched and not changed is not called
# changed (`git diff-index` reads no contents, and does call it so). Status
# would refresh the index, and does not here: GIT_OPTIONAL_LOCKS is off,
# which git documents as skipping the lock that rewrite needs. It is POSIX
# sh, git, and the tools git brings with it everywhere (awk, sed,
# grep, find), with `gh` where it is present and the remote is GitHub's, so
# that it runs wherever git does, under the sh that Git for Windows
# installs among them.

LC_ALL=C
export LC_ALL
# This is what keeps `git status` from rewriting the index.
GIT_OPTIONAL_LOCKS=0
export GIT_OPTIONAL_LOCKS

US=$(printf '\037')
rc=0
first=1

dir=${1:-.}
cd "$dir" 2>/dev/null || { echo "next: no folder $dir" >&2; exit 2; }
if top=$(git rev-parse --show-toplevel 2>/dev/null); then
  isgit=1
  cd "$top" || exit 2
else
  isgit=0
fi
here=$(pwd -P)
name=$(basename "$here")
now=$(date +%s)
thisyear=$(date +%Y)

# Prints a line of the screen: the first starts with the project's name,
# padded to 16 columns, and every later one is indented to match, so that
# a loop over projects lines up.
say() {
  if [ "$first" = 1 ]; then
    printf '%-15s %s\n' "$name" "$1"
    first=0
  else
    printf '%16s%s\n' '' "$1"
  fi
}

# --- Where the default branch is, and how long a branch may go unmerged

default=""
remote=""
assumed=""
dref=""
cur=""
find_default() {
  [ "$isgit" = 1 ] || return 0
  remote=$(git remote | sed -n 1p)
  if [ -n "$remote" ]; then
    default=$(git symbolic-ref -q "refs/remotes/$remote/HEAD" 2>/dev/null | sed "s|^refs/remotes/$remote/||")
    if [ -z "$default" ]; then
      default=$(git ls-remote --symref "$remote" HEAD 2>/dev/null | awk '/^ref:/ { sub("refs/heads/", "", $2); print $2; exit }')
    fi
  fi
  if [ -z "$default" ]; then
    assumed=1
    if git show-ref -q --verify refs/heads/main; then default=main
    elif git show-ref -q --verify refs/heads/master; then default=master
    elif [ -n "$remote" ] && git show-ref -q --verify "refs/remotes/$remote/master" && ! git show-ref -q --verify "refs/remotes/$remote/main"; then default=master
    else default=main
    fi
  fi
  if git show-ref -q --verify "refs/heads/$default"; then
    dref="refs/heads/$default"
  elif [ -n "$remote" ] && git show-ref -q --verify "refs/remotes/$remote/$default"; then
    dref="refs/remotes/$remote/$default"
  fi
  cur=$(git symbolic-ref -q --short HEAD 2>/dev/null)
}

# The project file's threshold, in days; 30 where it has none.
stale_days=30
stale_said=" (the project file does not say)"
read_threshold() {
  [ -f AGENTS.md ] || return 0
  n=$(sed -n 's/.*\*\*Stale after:\*\*[^0-9]*\([0-9][0-9]*\).*/\1/p' AGENTS.md | sed -n 1p)
  if [ -n "$n" ]; then
    stale_days=$n
    stale_said=""
  fi
}

# --- The plans

# One awk program, fed a file, printing a record for each plan in it: P for
# a plan read, R for one refused, with fields joined by the unit separator.
parse_plans() {
  awk '
  BEGIN {
    OFS = "\037"
    D = "[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]"
    seen = 0; infence = 0; active = 0; refused = 0
  }
  function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t\r]+$/, "", s); return s }
  function boxtext(t,   b) {
    t = trim(t)
    if (match(t, /\*\*[^*]+\*\*/)) b = substr(t, RSTART + 2, RLENGTH - 4)
    else b = t
    gsub(/`/, "", b); gsub(/\*\*/, "", b)
    sub(/^_+/, "", b); sub(/_+$/, "", b)
    gsub(/_+ /, " ", b); gsub(/ _+/, " ", b)
    b = trim(b)
    sub(/^[0-9]+\. /, "", b)
    sub(/^Part [0-9]+[a-z]*: /, "", b)
    while (b ~ /[:,.]$/) sub(/[:,.]$/, "", b)
    return trim(b)
  }
  function classify(line,   h, s, a, d) {
    kind = ""; sn = ""; sm = ""; extra = ""; lhash = ""
    if (line ~ ("^State: agreed " D "\\.?$")) { kind = "agreed"; return 1 }
    if (line ~ /^State: building, part [1-9][0-9]* of [1-9][0-9]*\.?$/) {
      kind = "building"; s = line
      sub(/^State: building, part /, "", s); sub(/\.$/, "", s)
      split(s, a, " of "); sn = a[1]; sm = a[2]
      return 1
    }
    if (line ~ ("^State: landed on [^ ]+ at [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]*, " D "\\.?$")) {
      h = line; sub(/^.* at /, "", h); sub(/,.*/, "", h)
      if (length(h) > 40) return 0
      d = line; sub(/\.$/, "", d)
      kind = "landed"; extra = substr(d, length(d) - 9); lhash = h
      return 1
    }
    if (line ~ /^State: parked, ./) {
      kind = "parked"; extra = line; sub(/^State: parked, /, "", extra)
      return 1
    }
    return 0
  }
  function flush() {
    if (active && !refused)
      print "P", title, kind, sn, sm, ticked, open, dropped, k, nexttext, extra, lhash
    active = 0
  }
  /^```/ { infence = !infence; next }
  infence { next }
  /^# / {
    flush()
    seen = 1; active = 1; refused = 0; wait = 1
    title = trim(substr($0, 3))
    ticked = 0; open = 0; dropped = 0; k = 0; nexttext = ""
    next
  }
  !active || refused { next }
  wait {
    if ($0 ~ /^[ \t\r]*$/) next
    wait = 0
    tl = trim($0)
    if (tl !~ /^State:/) { print "R", "no state line under \"" title "\""; refused = 1; next }
    if (!classify(tl)) { print "R", "the state line is not one of the four: \"" tl "\""; refused = 1; next }
    next
  }
  /^- \[[ x-]\]( |$)/ {
    mark = substr($0, 4, 1)
    if (mark == "x") ticked++
    else if (mark == "-") dropped++
    else {
      cnt = ticked + open
      open++
      if (!k) { k = cnt + 1; nexttext = boxtext(substr($0, 6)) }
    }
  }
  END {
    flush()
    if (!seen) print "R", "no title"
  }' "$1"
}

# When a plan last moved, as the row's last column says it.
plan_date() {
  [ "$isgit" = 1 ] || return 0
  pd_st=$(git status --porcelain -- "$1" 2>/dev/null)
  case $pd_st in
    "??"*) printf 'untracked'; return 0 ;;
    ?*) printf 'uncommitted'; return 0 ;;
  esac
  d=$(git log -1 --format=%cd --date='format:%d %b %Y' -- "$1" 2>/dev/null)
  if [ -z "$d" ]; then
    printf 'untracked'
    return 0
  fi
  case $d in
    *" $thisyear") d=${d% *} ;;
  esac
  printf '%s' "$d"
}

# A row: the title, the state, the next step and the date, in columns.
# Nothing is cut: a longer one pushes the rest right, since a reader cannot
# tell what was lost.
format_row() {
  T=$1 S=$2 X=$3 D=$4 awk '
  BEGIN { printf "%-45s %-17s %-35s %s\n", ENVIRON["T"], ENVIRON["S"], ENVIRON["X"], ENVIRON["D"] }' | sed 's/  *$//'
}

# Where the plan is: on the branch the checkout is on, or on which others.
plan_where() {
  pw_file=$1 pw_kind=$2 pw_date=$3
  [ "$isgit" = 1 ] && [ -n "$dref" ] && [ -n "$cur" ] || return 0
  if [ "$cur" != "$default" ]; then
    if ! git cat-file -e "$dref:$pw_file" 2>/dev/null || ! git diff --quiet "$dref" HEAD -- "$pw_file" 2>/dev/null; then
      say "  on $cur, not yet on $default"
    fi
    return 0
  fi
  pw_others=""
  pw_refs=$(git for-each-ref --format='%(refname)' refs/heads refs/remotes)
  while IFS= read -r pw_r; do
    [ -n "$pw_r" ] || continue
    pw_n=${pw_r#refs/heads/}
    pw_n=${pw_n#refs/remotes/}
    case $pw_n in
      "$default" | "$remote/$default" | */HEAD) continue ;;
    esac
    git cat-file -e "$pw_r:$pw_file" 2>/dev/null || continue
    git diff --quiet "$pw_r" "$dref" -- "$pw_file" 2>/dev/null && continue
    if [ -z "$pw_others" ]; then pw_others=$pw_n; else pw_others="$pw_others, $pw_n"; fi
  done <<EOT
$pw_refs
EOT
  if [ -n "$pw_others" ]; then
    say "  differs on $pw_others"
  elif [ "$pw_kind" != parked ] && [ "$pw_date" != uncommitted ] && [ "$pw_date" != untracked ]; then
    say "  no branch is at work on it"
  fi
}

rows_open=""
nlanded=0
lastdate=""
lasttitle=""

# Reads one file of plans and prints a row for each open one.
read_plan_file() {
  rpf_file=$1
  rpf_recs=$(parse_plans "$rpf_file")
  while IFS=$US read -r r_tag r_title r_kind r_n r_m r_ticked r_open r_dropped r_k r_next r_extra r_hash; do
    case $r_tag in
      R)
        say "$rpf_file: refused, $r_title"
        rc=1
        ;;
      P)
        if [ "$r_kind" = landed ]; then
          nlanded=$((nlanded + 1))
          if [ -z "$lastdate" ] || [ "$(printf '%s\n%s\n' "$lastdate" "$r_extra" | sort | sed -n '$p')" = "$r_extra" ]; then
            lastdate=$r_extra
            lasttitle=$r_title
          fi
          if [ "$isgit" = 1 ] && [ -n "$dref" ]; then
            if ! git cat-file -e "$r_hash^{commit}" 2>/dev/null || ! git merge-base --is-ancestor "$r_hash" "$dref" 2>/dev/null; then
              say "$r_title: landed at $r_hash, which $default does not have"
            fi
          fi
          continue
        fi
        rows_open=1
        rp_total=$((r_ticked + r_open))
        rp_next=""
        if [ "$r_kind" = parked ]; then
          rp_next="parked: $r_extra"
        elif [ "$r_open" -gt 0 ]; then
          rp_next="next: $r_k, $r_next"
        elif [ "$r_kind" = building ] && [ "$rp_total" -gt 0 ]; then
          rp_next="every box ticked: say landed, or parked"
        fi
        rp_date=$(plan_date "$rpf_file")
        say "$(format_row "$r_title" "$r_kind, $r_ticked of $rp_total" "$rp_next" "$rp_date")"
        [ "$r_dropped" -gt 0 ] && say "  and $r_dropped dropped"
        if [ "$r_kind" = building ]; then
          if [ "$r_open" -eq 0 ] && [ "$rp_total" -gt 0 ]; then
            say "  the state line says building; every box is ticked: say landed, or parked"
          elif [ "$r_open" -gt 0 ] && { [ "$r_n" != "$r_k" ] || [ "$r_m" != "$rp_total" ]; }; then
            say "  the state line says part $r_n of $r_m; the boxes say $r_ticked of $rp_total ticked, next $r_k"
          fi
        elif [ "$r_kind" = agreed ] && [ "$r_ticked" -gt 0 ]; then
          say "  the state line says agreed; $r_ticked ticked"
        fi
        plan_where "$rpf_file" "$r_kind" "$rp_date"
        ;;
    esac
  done <<EOT
$rpf_recs
EOT
}

show_plans() {
  found=0
  for f in plans/*.md PLAN.md; do
    [ -f "$f" ] || continue
    found=1
    read_plan_file "$f"
  done
  if [ "$found" = 0 ]; then
    say "no plans/ and no PLAN.md"
    return 0
  fi
  if [ "$nlanded" -eq 1 ]; then
    say "1 plan landed"
  elif [ "$nlanded" -gt 1 ]; then
    say "$nlanded plans landed"
  fi
  if [ "$nlanded" -gt 0 ] && [ -z "$rows_open" ]; then
    say "nothing open; last landed: $lasttitle, $lastdate"
  fi
}

# The changes in a tree, from status: the files changed or staged, or the
# files not tracked, as names one a line. Quotes and rename arrows are
# taken off the names.
tree_names() {
  git -C "$1" status --porcelain --untracked-files=all 2>/dev/null | awk -v want="$2" '
  {
    untracked = (substr($0, 1, 2) == "??")
    if ((want == "untracked") != untracked) next
    n = substr($0, 4)
    if (match(n, / -> /)) n = substr(n, RSTART + 4)
    gsub(/^"|"$/, "", n)
    print n
  }'
}

# True when any of the files named, in the tree, was modified in the last hour.
any_recent() {
  ar_dir=$1 ar_files=$2 ar_hit=""
  while IFS= read -r ar_f; do
    [ -n "$ar_f" ] || continue
    [ -n "$(find "$ar_dir/$ar_f" -mmin -60 2>/dev/null)" ] && ar_hit=1
  done <<EOT
$ar_files
EOT
  [ -n "$ar_hit" ]
}

# --- What tidy would find

# The age of a time, in tidy's words: today, 1 day old, n days old.
age_text() {
  at_days=$(($1 / 86400))
  if [ "$at_days" -le 0 ]; then printf 'today'
  elif [ "$at_days" -eq 1 ]; then printf '1 day old'
  else printf '%s days old' "$at_days"
  fi
}

# One branch, local or remote: merged by ancestry, or how far apart.
branch_line() {
  bl_name=$1 bl_ref=$2 bl_ts=$3 bl_with=""
  case $wt_inuse in
    *"|$bl_name|"*) [ "$bl_ref" = "refs/heads/$bl_name" ] && bl_with=", in use with its worktree" ;;
  esac
  if git merge-base --is-ancestor "$bl_ref" "$dref" 2>/dev/null; then
    say "branch $bl_name: merged$bl_with"
    return 0
  fi
  bl_lr=$(git rev-list --count --left-right "$dref...$bl_ref" 2>/dev/null)
  set -- $bl_lr
  bl_behind=${1:-0}
  bl_ahead=${2:-0}
  bl_secs=$((now - ${bl_ts:-$now}))
  [ "$bl_secs" -lt 0 ] && bl_secs=0
  bl_stale=""
  [ "$bl_secs" -gt $((stale_days * 86400)) ] && bl_stale=", stale"
  say "branch $bl_name: not merged by ancestry, $bl_ahead ahead, $bl_behind behind, $(age_text "$bl_secs")$bl_stale$bl_with"
}

count_lines() { printf '%s\n' "$1" | grep -c .; }

show_branches() {
  sb_which=$1 sb_prefix=$2
  sb_refs=$(git for-each-ref --format='%(refname)|%(committerdate:unix)' "$sb_which")
  while IFS='|' read -r sb_r sb_ts; do
    [ -n "$sb_r" ] || continue
    sb_n=${sb_r#"$sb_prefix"}
    case $sb_n in
      "$default" | "$remote/$default" | */HEAD) continue ;;
    esac
    branch_line "$sb_n" "$sb_r" "$sb_ts"
  done <<EOT
$sb_refs
EOT
}

# A worktree's judgement: in use, or clean or changed, and merged or not.
worktree_judgement() {
  wj_path=$1 wj_head=$2 wj_locked=$3 wj_prunable=$4 wj_reason=$5
  wj_files=""
  if [ -d "$wj_path" ]; then
    wj_files=$({ tree_names "$wj_path" changed; tree_names "$wj_path" untracked; } | grep .)
  fi
  if [ "$wj_locked" = 1 ]; then
    wj_say="in use (locked)"
    [ -n "$wj_reason" ] && wj_say="$wj_say: $wj_reason"
  elif any_recent "$wj_path" "$wj_files"; then
    wj_say="in use (changed in the last hour)"
  else
    if [ -n "$wj_files" ]; then wj_say=changed; else wj_say=clean; fi
    if git merge-base --is-ancestor "$wj_head" "$dref" 2>/dev/null; then
      wj_say="$wj_say, merged"
    else
      wj_say="$wj_say, not merged by ancestry"
    fi
  fi
  [ "$wj_prunable" = 1 ] && wj_say="$wj_say, prunable"
  printf '%s' "$wj_say"
}

# Every worktree but this one, as lines for the screen, and the branches of
# those that are in use, which are in use with them. Worked out before the
# branches are said.
wt_lines=""
wt_inuse="|"
collect_worktrees() {
  sw_recs=$(git worktree list --porcelain 2>/dev/null | awk '
  BEGIN { OFS = "\037" }
  function out() { if (p != "" && !bare) print p, h, b, d, l, pr, r; p = ""; h = ""; b = ""; d = 0; l = 0; pr = 0; r = ""; bare = 0 }
  /^worktree / { out(); p = substr($0, 10); next }
  /^HEAD / { h = substr($0, 6); next }
  /^branch / { b = $0; sub(/^branch refs\/heads\//, "", b); next }
  /^detached/ { d = 1; next }
  /^locked/ { l = 1; r = $0; sub(/^locked ?/, "", r); next }
  /^prunable/ { pr = 1; next }
  /^bare/ { bare = 1; next }
  END { out() }')
  while IFS=$US read -r sw_path sw_head sw_branch sw_detached sw_locked sw_prunable sw_reason; do
    [ -n "$sw_path" ] || continue
    sw_real=$(cd "$sw_path" 2>/dev/null && pwd -P) || sw_real=$sw_path
    [ "$sw_real" = "$here" ] && continue
    if [ "$sw_detached" = 1 ] || [ -z "$sw_branch" ]; then
      sw_on="detached at $(printf '%s' "$sw_head" | cut -c1-7)"
    else
      sw_on=$sw_branch
    fi
    case $sw_path in
      "$here"/*) sw_show=${sw_path#"$here"/} ;;
      *) sw_show=$sw_path ;;
    esac
    sw_j=$(worktree_judgement "$sw_path" "$sw_head" "$sw_locked" "$sw_prunable" "$sw_reason")
    case $sw_j in
      "in use"*) [ -n "$sw_branch" ] && wt_inuse="$wt_inuse$sw_branch|" ;;
    esac
    wt_lines="${wt_lines}worktree $sw_show on $sw_on: $sw_j
"
  done <<EOT
$sw_recs
EOT
}

show_worktrees() {
  while IFS= read -r sw_l; do
    [ -n "$sw_l" ] && say "$sw_l"
  done <<EOT
$wt_lines
EOT
}

show_prs() {
  if [ -z "$remote" ]; then
    say "PRs not read: no remote"
    return 0
  fi
  if ! command -v gh >/dev/null 2>&1; then
    say "PRs not read: gh is not on the path"
    return 0
  fi
  sp_url=$(git remote get-url "$remote" 2>/dev/null)
  case $sp_url in
    *github.com*) ;;
    *)
      say "PRs not read: the remote is not GitHub"
      return 0
      ;;
  esac
  sp_out=$(gh pr list --state open --json number,title,headRefName,updatedAt,author \
    --jq '.[] | "\(.number)\u001f\(.title)\u001f\(.author.login)\u001f\(.updatedAt)"' 2>&1)
  sp_status=$?
  if [ "$sp_status" -ne 0 ]; then
    say "PRs not read: $(printf '%s\n' "$sp_out" | sed -n 1p | cut -c1-80)"
    return 0
  fi
  if [ -z "$sp_out" ]; then
    say "no open PRs"
    return 0
  fi
  sp_lines=$(printf '%s\n' "$sp_out" | NOW=$now STALE=$((stale_days * 86400)) awk '
  BEGIN { FS = "\037" }
  # Days since 1970-01-01 for a civil date, by the standard sum.
  function days(y, m, d,   era, yoe, doy, doe) {
    if (m <= 2) y--
    era = int(y / 400); yoe = y - era * 400
    doy = int((153 * (m + (m > 2 ? -3 : 9)) + 2) / 5) + d - 1
    doe = yoe * 365 + int(yoe / 4) - int(yoe / 100) + doy
    return era * 146097 + doe - 719468
  }
  {
    ts = $4; gsub(/[-:TZ]/, " ", ts); split(ts, a, " ")
    secs = ENVIRON["NOW"] - (days(a[1] + 0, a[2] + 0, a[3] + 0) * 86400 + a[4] * 3600 + a[5] * 60 + a[6])
    if (secs < 0) secs = 0
    n = int(secs / 86400)
    age = (n == 0) ? "today" : (n == 1) ? "1 day old" : n " days old"
    st = (secs > ENVIRON["STALE"]) ? ", stale" : ""
    printf "PR #%s \"%s\" by %s, updated %s%s\n", $1, $2, $3, age, st
  }')
  while IFS= read -r sp_l; do
    [ -n "$sp_l" ] && say "$sp_l"
  done <<EOT
$sp_lines
EOT
}

show_git() {
  [ "$isgit" = 1 ] || return 0
  read_threshold
  if [ -n "$assumed" ]; then sg_where="(assumed)"; else sg_where="($remote)"; fi
  say "git: on ${cur:-(detached)}, default $default $sg_where, stale after $stale_days days$stale_said"
  if [ -z "$cur" ]; then
    say "HEAD detached at $(git rev-parse --short HEAD 2>/dev/null)"
  fi
  sg_changed=$(tree_names . changed)
  sg_untracked=$(tree_names . untracked)
  sg_nc=$(count_lines "$sg_changed")
  sg_nu=$(count_lines "$sg_untracked")
  if [ "$sg_nc" -gt 0 ] || [ "$sg_nu" -gt 0 ]; then
    if [ "$sg_nc" -eq 1 ]; then sg_files="1 file changed"; else sg_files="$sg_nc files changed"; fi
    sg_use=""
    any_recent . "$(printf '%s\n%s\n' "$sg_changed" "$sg_untracked")" && sg_use=", in use (changed in the last hour)"
    say "uncommitted: $sg_files, $sg_nu untracked$sg_use"
  fi
  sg_stash=$(count_lines "$(git stash list 2>/dev/null)")
  [ "$sg_stash" -gt 0 ] && say "stash: $sg_stash"
  if [ -n "$remote" ] && [ -n "$dref" ] && git show-ref -q --verify "refs/remotes/$remote/$default"; then
    sg_ahead=$(git rev-list --count "refs/remotes/$remote/$default..$dref" 2>/dev/null)
    if [ "${sg_ahead:-0}" -eq 1 ]; then
      say "$default: 1 commit not pushed to $remote/$default"
    elif [ "${sg_ahead:-0}" -gt 1 ]; then
      say "$default: $sg_ahead commits not pushed to $remote/$default"
    fi
  fi
  if [ -n "$dref" ]; then
    collect_worktrees
    show_branches refs/heads refs/heads/
    show_branches refs/remotes refs/remotes/
    show_worktrees
  fi
  show_prs
}

# --- Since the last tag

show_tag() {
  [ "$isgit" = 1 ] && [ -n "$dref" ] || return 0
  if st_tag=$(git describe --tags --abbrev=0 "$dref" 2>/dev/null); then
    st_n=$(git rev-list --count "$st_tag..$dref")
    if [ "$st_n" -eq 1 ]; then st_w=commit; else st_w=commits; fi
    say "$default: $st_tag, $st_n $st_w since"
    st_log=$(git log -3 --format=%s "$st_tag..$dref")
    while IFS= read -r st_l; do
      [ -n "$st_l" ] && say "  $st_l"
    done <<EOT
$st_log
EOT
  else
    st_n=$(git rev-list --count "$dref")
    if [ "$st_n" -eq 1 ]; then st_w=commit; else st_w=commits; fi
    say "$default: no tag yet, $st_n $st_w"
    st_log=$(git log -3 --format=%s "$dref")
    while IFS= read -r st_l; do
      [ -n "$st_l" ] && say "  $st_l"
    done <<EOT
$st_log
EOT
  fi
}

find_default
show_plans
show_git
show_tag
exit "$rc"
